execute_process(COMMAND "${TEST_EXECUTABLE}" --list-test-cases --no-colors RESULT_VARIABLE rc OUTPUT_VARIABLE cases)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "Test discovery failed: ${rc}")
endif()
string(REPLACE "\n" ";" lines "${cases}")
file(WRITE "${TEST_FILE}" "")
foreach(line IN LISTS lines)
 if(line MATCHES "^(unit|integration|regression|stress)\\.")
  file(APPEND "${TEST_FILE}" "add_test([==[${line}]==] [==[${TEST_EXECUTABLE}]==] [==[--test-case=${line}]==] --no-colors)\nset_tests_properties([==[${line}]==] PROPERTIES TIMEOUT 15)\n")
 endif()
endforeach()
